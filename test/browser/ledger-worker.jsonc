 "vars":{"LEDGER_SYNC_LOCAL_AUTH":"true","LEDGER_SYNC_ENABLED":"true","SUPABASE_URL":"http://127.0.0.1:1","SUPABASE_PUBLISHABLE_KEY":"local-fixture"}
}
