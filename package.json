{
  "name": "hearth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "description": "A dependable household budget for Jonathan and Bianca — portable ledger, Toronto time, CAD, Bianca-first interface.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "rm -rf dist && tsc --noEmit && vite build && test ! -e dist/_redirects",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:verify": "node scripts/verify-ai-surface.mjs",
    "check": "pnpm ai:verify && pnpm test && pnpm build",
    "pack:claude-ux": "node scripts/pack-claude-ux.mjs",
    "pack:claude-mobile": "node scripts/pack-claude-mobile.mjs",
    "pack:claude-desktop": "node scripts/pack-claude-desktop.mjs",
    "books:apply": "node --env-file=.env scripts/apply-supabase-schema.mjs",
    "books:apply:002": "node scripts/apply-supabase-migration.mjs 002",
    "books:apply:007": "node scripts/apply-supabase-migration.mjs 007",
    "books:apply:008": "node scripts/apply-supabase-migration.mjs 008",
    "books:smoke:cas": "node scripts/smoke-snapshot-cas.mjs",
    "cf:deploy": "pnpm build && rm -f dist/_redirects && wrangler deploy --assets=./dist",
    "cf:preview": "pnpm build && rm -f dist/_redirects && wrangler versions upload --assets=./dist"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "postgres": "^3.4.9",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.125.0"
  }
}
