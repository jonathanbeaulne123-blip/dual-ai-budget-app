VITE_SUPABASE_URL=https://tykhocwacaxwquhynkok.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
# Kitchen Auth door (D-123). Set to 1 to use Supabase Auth Google → auth.uid().
# Live kitchen: GitHub Actions variable VITE_SUPABASE_AUTH_ENABLED=1 (not a secret).
# URL/key may be omitted locally; the client falls back to the bundled Development project.
VITE_SUPABASE_AUTH_ENABLED=
# Tier 1 Realtime push (D-149 T1-S3). Requires Auth + Migration 014 publication.
# Live kitchen: baked as 1 in .github/workflows/pages.yml (main deploy).
VITE_CONTINUITY_REALTIME=1
# Optional override for the registered Hercules Pro ChatGPT app URL.
# The registered private Development app is the built-in fallback. Free in-app Hercules does not use this.
VITE_HERCULES_PRO_URL=
# Production continuity stays off until export/seed decisions: VITE_PRODUCTION_CONTINUITY=1
VITE_PRODUCTION_CONTINUITY=
SUPABASE_SECRET_KEY=
# Real Postgres password from Connect (not [YOUR-PASSWORD], not the API secret).
# Direct db.*.supabase.co is IPv6-only. pnpm books:apply uses the us-east-1 session pooler.
# Database name is postgres. Dashboard URIs that end in /postgresz are a typo.
SUPABASE_DB_PASSWORD=
DATABASE_URL=
# OAuth 2.0 Web client ID from Google Cloud. Public. Authorized JS origins:
# http://localhost:5173 and the Cloudflare Workers URL. Never put a client secret here.
# Scopes: openid / email / profile + Calendar by default. Drive/Contacts/Gmail/Sheets are opt-in.
# See docs/GOOGLE.md. Add test users on the OAuth consent screen while the app is in testing.
VITE_GOOGLE_CLIENT_ID=
# Hercules talk — third-party keys are allowed (D-045). Not forbidden.
# Put them on the Worker, not in VITE_, not in the household snapshot, not in git.
# wrangler secret put OPENAI_API_KEY
# wrangler secret put ANTHROPIC_API_KEY
# Flinks demo bank feed (Worker secrets only — never VITE_):
# wrangler secret put FLINKS_CUSTOMER_ID
# wrangler secret put FLINKS_API_KEY
# wrangler secret put FLINKS_SECRET_KEY
# wrangler secret put FLINKS_CONNECTION_ENCRYPTION_KEY
# wrangler secret put FLINKS_DIGEST_KEY
# Toolbox API, iframe, callback, and Development-only flags are fixed public vars in wrangler.jsonc.
# Model names are public wrangler vars in wrangler.jsonc (OPENAI_MODEL, ANTHROPIC_MODEL).
