VITE_SUPABASE_URL=https://tykhocwacaxwquhynkok.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Real Postgres password from Connect (not [YOUR-PASSWORD], not the API secret).
# Direct db.*.supabase.co is IPv6-only. pnpm books:apply uses the us-east-1 session pooler.
# Database name is postgres. Dashboard URIs that end in /postgresz are a typo.
SUPABASE_DB_PASSWORD=
DATABASE_URL=
# OAuth 2.0 Web client ID from Google Cloud. Public. Authorized JS origins:
# http://localhost:5173 and the Cloudflare Workers URL. Never put a client secret here.
# Scopes: openid / email / profile + Calendar by default. Drive/Contacts/Gmail/Sheets are opt-in.
# See docs/GOOGLE.md. Add test users on the OAuth consent screen while the app is in testing.
VITE_GOOGLE_CLIENT_ID=
