{
  "type": "workspace_readwrite",
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "registry.npmjs.org",
      "npmjs.org",
      "github.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "*.githubusercontent.com"
    ],
    "deny": [
      "mcp.supabase.com",
      "*.supabase.co",
      "api.cloudflare.com",
      "*.workers.dev",
      "*.pages.dev"
    ]
  },
  "enableSharedBuildCache": true
}
