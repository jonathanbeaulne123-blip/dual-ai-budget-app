description: Hosted-data, Supabase, synchronization, privacy, model-disclosure, and Production rules
globs: "src/api.ts,src/ledger/supabase.ts,src/core/herculesPrivacy.ts,src/core/pass.ts,src/Pairing.tsx,src/storage.ts,supabase/**,sql/**,workers/**,test/**/*supabase*.ts,test/**/*sync*.ts,test/**/*hercules*.ts"
alwaysApply: false
