{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["@cloudflare/workers-types", "vite/client"],
    "strict": true, "skipLibCheck": true, "noEmit": true, "allowJs": true,
    "allowImportingTsExtensions": true, "jsx": "react-jsx"
  },
  "include": ["*.ts"]
}
