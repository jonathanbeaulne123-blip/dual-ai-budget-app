{
  "manifest_version": 3,
  "name": "Hearth 7shifts Capture (Development)",
  "version": "0.2.0",
  "description": "Captures fixed employee-visible 7shifts schedule, timesheet, and optional read-only Gmail projections while Chrome is running.",
  "permissions": ["activeTab", "scripting", "storage", "alarms", "tabs", "identity"],
  "host_permissions": ["https://app.7shifts.com/*", "https://www.googleapis.com/*", "https://gmail.googleapis.com/*", "https://hearth-books.jonathan-beaulne123.workers.dev/work/evidence/*"],
  "action": {
    "default_title": "Capture this 7shifts session",
    "default_popup": "popup.html"
  },
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "oauth2": {
    "client_id": "118841732569-0p8gsn92d96jcci9dh5so0svtf64c73f.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
  },
  "content_scripts": [{
    "matches": ["https://app.7shifts.com/*"],
    "js": ["capture-safety.js", "content.js"],
    "run_at": "document_start",
    "all_frames": false
  }],
  "web_accessible_resources": [{
    "resources": ["capture-safety.js", "page-bridge.js"],
    "matches": ["https://app.7shifts.com/*"]
  }]
}
