+ const ids=data.triangles[index]!,p=ORCHARD_JUNCTION_POINTS[ids[0]!]!,q=ORCHARD_JUNCTION_POINTS[ids[1]!]!,r=ORCHARD_JUNCTION_POINTS[ids[2]!]!;
