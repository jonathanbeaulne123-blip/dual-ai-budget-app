+  const key=`${x}:${z}`,bucket=cells.get(key)??[];bucket.push(face);cells.set(key,bucket);
+ }
+}
+export function orchardJunctionAt(x:number,z:number,ceiling=Infinity):Hit|null{
+ let hit:Hit|null=null;
