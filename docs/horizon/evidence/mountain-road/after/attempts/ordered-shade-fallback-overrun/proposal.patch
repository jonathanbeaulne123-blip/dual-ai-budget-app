+    if (saved) { saved.material.forceSinglePass = saved.single; saved.material.side = saved.side; saved = null; }
+  }
+  mesh.onBeforeRender = function(...args) {
+    restoreMaterial(); before.apply(mesh, args);
+    index.array.set(source); // Inactive draw-range indices and every fallback retain original order.
+    const material = mesh.material;
+    const supported = !Array.isArray(material) && (material as THREE.MeshBasicMaterial).isMeshBasicMaterial &&
+      material.transparent && !material.depthWrite && material.side === THREE.DoubleSide &&
+      !(material as THREE.MeshBasicMaterial).envMap && !(mesh as THREE.InstancedMesh).isInstancedMesh && !geometry.morphAttributes.position;
+    const result = supported ? order(args[2]) : 'unsupported';
+    mesh.userData.contactShadePass = result;
+    index.needsUpdate = true; // r185 BindingStates uploads the index after this callback, in the same draw.
+    if (supported && !Array.isArray(material)) {
+      saved = {material, single: material.forceSinglePass, side: material.side};
+      material.forceSinglePass = result === 'ordered';
+    }
+  };
+  mesh.onAfterRender = function(...args) { try { after.apply(mesh, args); } finally { restoreMaterial(); } };
+  const installedBefore = mesh.onBeforeRender, installedAfter = mesh.onAfterRender;
+  function dispose() {
+    if (disposed) return; disposed = true; restoreMaterial();
+    if (mesh.onBeforeRender === installedBefore) mesh.onBeforeRender = before;
+    if (mesh.onAfterRender === installedAfter) mesh.onAfterRender = after;
+    index.array.set(source); index.needsUpdate = true;
+    geometry.removeEventListener('dispose', dispose);
+    // The builder owns geometry/index disposal. No material clone or texture is created.
+  }
+  geometry.addEventListener('dispose', dispose);
+  return dispose;
+}
